{
  "name": "markdown-selection-notes",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.2.0",
  "publisher": "ethan-heo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethan-heo/markdown-notes.git"
  },
  "bugs": {
    "url": "https://github.com/ethan-heo/markdown-notes/issues"
  },
  "homepage": "https://github.com/ethan-heo/markdown-notes#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.previewScripts": [
      "./media/preview.js"
    ],
    "commands": [
      {
        "command": "markdownSelectionNotes.openPreview",
        "title": "%command.openPreview%"
      },
      {
        "command": "markdownSelectionNotes.addNote",
        "title": "%command.addNote%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownSelectionNotes.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@10"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownSelectionNotes.addNote",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "markdownSelectionNotes.previewColumn": {
          "type": "string",
          "enum": [
            "beside",
            "active"
          ],
          "default": "beside",
          "description": "%configuration.previewColumn.description%"
        },
        "markdownSelectionNotes.highlightColor": {
          "type": "string",
          "default": "#ffd33d",
          "description": "%configuration.highlightColor.description%"
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:markdownSelectionNotes.openPreview",
    "onCommand:markdownSelectionNotes.addNote"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "tsc --noEmit -p ./tsconfig.json",
    "test": "node --test test/*.test.js",
    "test:e2e:dom": "mocha --timeout 10000 test/e2e/preview.dom.test.js",
    "test:e2e:extension": "npm run compile && node test/e2e/run-extension-host.js",
    "test:e2e:ui": "npm run compile && E2E_UI=1 node test/e2e/run-extension-host.js",
    "test:e2e:demo": "npm run compile && E2E_UI=1 E2E_DEMO=1 node test/e2e/run-extension-host.js",
    "test:e2e:ui:visible": "npm run compile && E2E_UI=1 E2E_KEEP_OPEN=1 node test/e2e/run-extension-host.js",
    "test:e2e:visible": "npm run test:e2e:ui:visible",
    "test:e2e": "npm run test:e2e:dom && npm run test:e2e:extension"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "gif-encoder-2": "^1.0.5",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.3.0"
  }
}
