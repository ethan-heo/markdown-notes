{
  "name": "markdown-selection-notes",
  "displayName": "Markdown Selection Notes",
  "description": "Markdown Preview에서 드래그한 영역에 메모를 남깁니다.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Markdown"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.previewScripts": [
      "./media/preview.js"
    ],
    "commands": [
      {
        "command": "markdownSelectionNotes.openPreview",
        "title": "Markdown Selection Notes: Preview 열기"
      },
      {
        "command": "markdownSelectionNotes.addNote",
        "title": "Markdown Selection Notes: 선택 영역에 메모 남기기"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownSelectionNotes.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@10"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownSelectionNotes.addNote",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Selection Notes",
      "properties": {
        "markdownSelectionNotes.previewColumn": {
          "type": "string",
          "enum": [
            "beside",
            "active"
          ],
          "default": "beside",
          "description": "메모 Preview를 여는 위치입니다."
        },
        "markdownSelectionNotes.highlightColor": {
          "type": "string",
          "default": "#ffd33d",
          "description": "기본 Markdown Preview에서 메모가 연결된 영역에 사용할 하이라이팅 색상입니다. 예: #ffd33d, rgba(255, 211, 61, 0.75)"
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:markdownSelectionNotes.openPreview",
    "onCommand:markdownSelectionNotes.addNote"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "tsc --noEmit -p ./tsconfig.json",
    "test": "node --test test/*.test.js",
    "test:e2e:dom": "mocha --timeout 10000 test/e2e/preview.dom.test.js",
    "test:e2e:extension": "npm run compile && node test/e2e/run-extension-host.js",
    "test:e2e:ui": "npm run compile && E2E_UI=1 node test/e2e/run-extension-host.js",
    "test:e2e:ui:visible": "npm run compile && E2E_UI=1 E2E_KEEP_OPEN=1 node test/e2e/run-extension-host.js",
    "test:e2e:visible": "npm run test:e2e:ui:visible",
    "test:e2e": "npm run test:e2e:dom && npm run test:e2e:extension"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "playwright": "^1.64.1",
    "typescript": "^5.3.0"
  }
}
